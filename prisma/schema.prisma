// ─────────────────────────────────────────────────────────────
// TikTokFlow — schema do banco (Postgres via Prisma)
// Multi-loja: cada Store tem sua própria API Key da Nerva,
// seus produtos e seus pedidos.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuário do painel admin (você e, no futuro, donos de loja)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // hash bcrypt — nunca senha em texto puro
  name      String?
  role      Role     @default(OWNER)
  stores    Store[] // lojas que este usuário administra
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN // você — vê tudo
  OWNER // dono de uma ou mais lojas
}

// Loja / vitrine
model Store {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique // vitrine acessível em /{slug}
  description String?
  domain      String? @unique // domínio próprio, opcional
  active      Boolean @default(true)

  // Credenciais Nerva — UMA POR LOJA (conforme decidido)
  // A API key fica só no servidor. Nunca exposta ao frontend.
  nervaApiKey        String? // sk_live_...
  nervaWebhookSecret String? // secret pra validar o HMAC do webhook

  // Pixels de anúncio (para tráfego pago desde o início)
  // Para onde o cliente vai depois de pagar. Vazio mantém o
  // comportamento atual: fica no checkout, com o upsell.
  redirectUrl        String?
  redirectSkipUpsell Boolean @default(false) // pula o upsell e vai direto

  metaPixelId   String? // ID do Pixel do Facebook/Meta
  tiktokPixelId String? // ID do Pixel do TikTok
  googleAdsId   String? // ex: AW-XXXXXXXXX (opcional)

  // Conversions API PRÓPRIA — dispara Meta CAPI / TikTok Events API daqui,
  // sem depender do gateway. Ligue capiOwn E desligue a integração
  // equivalente no painel da Nerva, senão a compra conta duas vezes.
  // TikTok Marketing API — criação de campanha pelo painel.
  // ATENÇÃO: tiktokBusinessToken é OUTRO token, diferente do
  // tiktokAccessToken (que é só da Events API). Escopos distintos.
  tiktokAdvertiserId  String?
  tiktokBusinessToken String? @db.Text
  tiktokBcId          String? // Business Center — exigido pelo catálogo
  tiktokCatalogId     String? // catálogo criado/vinculado pelo painel

  capiOwn             Boolean @default(false)
  metaAccessToken     String? @db.Text // token da Conversions API do Meta
  metaTestEventCode   String? // TESTxxxxx — aba Testar Eventos (opcional)
  tiktokAccessToken   String? @db.Text // token da Events API do TikTok
  tiktokTestEventCode String? // código de teste do TikTok (opcional)

  owner    User        @relation(fields: [ownerId], references: [id])
  ownerId  String
  products Product[]
  orders   Order[]
  bumps    OrderBump[]
  upsells  Upsell[]

  checkoutTheme CheckoutTheme?
  collections   Collection[]
  campaigns     AdCampaign[]
  adSpend       AdSpend[]
  contaLotes    AdAccountBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Produto de uma loja
model Product {
  id             String   @id @default(uuid())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId        String
  title          String
  slug           String // checkout em /{store}/checkout/{slug}
  description    String?
  // valores em CENTAVOS pra evitar erro de ponto flutuante em dinheiro
  priceCents     Int
  compareAtCents Int? // preço "de" (riscado)
  imageUrl       String?
  active         Boolean  @default(true)
  redirectUrl    String? // sobrescreve o destino da loja, só para este produto
  orders         Order[]
  upsells        Upsell[]
  collections    Collection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

// Pedido / cobrança
model Order {
  id      String @id @default(uuid())
  store   Store  @relation(fields: [storeId], references: [id])
  storeId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  // Dados do comprador
  customerName     String?
  customerEmail    String?
  customerPhone    String? // usado no match da Conversions API (hash SHA-256)
  customerDocument String // CPF — obrigatório pela Nerva

  amountCents Int // valor cobrado, em centavos (produto + bump, se houver)
  feeCents    Int? // taxa Nerva (preenchida quando a Nerva responde)
  netCents    Int? // líquido

  // Order bump aceito neste pedido (opcional)
  bump   OrderBump? @relation(fields: [bumpId], references: [id])
  bumpId String?

  // Marca se este pedido é fruto de um upsell pós-compra
  isUpsell Boolean @default(false)

  status OrderStatus @default(PENDING)

  // Dados de rastreamento de marketing (pra atribuição de anúncio)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  ttclid      String?
  gclid       String?
  fbp         String?
  fbc         String?
  clientIp    String?
  clientUa    String? @db.Text

  // Vínculo com a Nerva
  nervaSaleId  String? @unique // id UUID que a Nerva devolve
  nervaTxId    String? // transactionId (adquirente)
  pixCode      String? @db.Text // copia-e-cola
  pixQrCodeUrl String? @db.Text // url do QR

  // Conversions API própria — carimbo de sucesso garante disparo ÚNICO
  // mesmo com as re-tentativas do webhook. Erro fica gravado pra diagnóstico.
  metaCapiAt      DateTime?
  metaCapiError   String?   @db.Text
  tiktokCapiAt    DateTime?
  tiktokCapiError String?   @db.Text

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
  @@index([status])
  @@index([nervaSaleId])
}

enum OrderStatus {
  PENDING // aguardando pagamento
  PAID // pago (confirmado via webhook)
  FAILED // falhou
  EXPIRED // expirou sem pagamento
  REFUNDED // estornado
}

// Order bump: oferta extra exibida DENTRO do checkout (um clique adiciona ao valor)
model OrderBump {
  id          String   @id @default(uuid())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId     String
  title       String // ex: "Leve também o brinde X"
  description String?
  priceCents  Int // valor adicional
  imageUrl    String?
  active      Boolean  @default(true)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
}

// Upsell: oferta exibida DEPOIS do pagamento aprovado (gera novo pedido/Pix)
model Upsell {
  id             String   @id @default(uuid())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId        String
  title          String
  description    String?
  priceCents     Int
  compareAtCents Int?
  imageUrl       String?
  // produto que o upsell entrega (reusa o catálogo)
  product        Product  @relation(fields: [productId], references: [id])
  productId      String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────
// Aparência do checkout, editável no painel (Construtor).
// Uma por loja. As cores viram CSS custom properties na página
// de checkout — por isso o construtor muda o layout inteiro sem
// tocar no componente.
// ─────────────────────────────────────────────────────────────
model CheckoutTheme {
  id      String @id @default(uuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String @unique

  // Identidade visual (hex) — sobrescrevem os tokens de globals.css
  brandColor String @default("#d4a012") // CTA, preços e destaques
  bgColor    String @default("#08080b")
  cardColor  String @default("#14141c")
  textColor  String @default("#f4f4f7")
  radiusPx   Int    @default(14)

  // Banner do topo (URL de imagem; mobile cai no desktop se vazio)
  bannerDesktopUrl String?
  bannerMobileUrl  String?

  // Barra de avisos fixa no topo
  noticeEnabled Boolean @default(false)
  noticeText    String?
  noticeBg      String  @default("#d4a012")
  noticeColor   String  @default("#08080b")

  // Cronômetro de escassez
  countdownEnabled Boolean @default(false)
  countdownMinutes Int     @default(15)
  countdownText    String  @default("Oferta reservada por")

  // Prova social
  socialProofEnabled Boolean @default(false)
  socialProofText    String?
  socialProofAvatars Boolean @default(true)

  // Selos de segurança abaixo do botão
  badgesEnabled Boolean @default(true)

  // Textos. {valor} no ctaText é trocado pelo total formatado.
  ctaText    String  @default("Pagar {valor}")
  footerText String?

  // Escape hatch: CSS injetado por último, sobrescreve tudo.
  customCss String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdPlatform {
  TIKTOK
  META
  MANUAL
}

// ─────────────────────────────────────────────────────────────
// Campanha criada pelo painel. Guarda os ids que a plataforma
// devolve em cada etapa (campanha → conjunto → anúncio) pra que
// uma falha no meio não deixe órfão invisível: o que já subiu
// fica registrado e o erro fica legível em lastError.
// ─────────────────────────────────────────────────────────────
model AdCampaign {
  id      String @id @default(uuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  platform    AdPlatform @default(TIKTOK)
  name        String
  objective   String
  budgetCents Int
  productId   String? // produto anunciado (id solto, sem FK)

  externalCampaignId String?
  externalAdgroupId  String?
  externalAdId       String?

  status    String  @default("CRIANDO") // CRIANDO | ATIVA | ERRO
  lastError String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────
// Gasto de anúncio por dia. Alimentado pela sincronia com o
// TikTok ou digitado à mão (plataforma MANUAL) — é o que permite
// o BI cruzar receita com custo e mostrar lucro de verdade.
//
// externalCampaignId usa "" em vez de null de propósito: no
// Postgres NULLs são distintos entre si, e a chave única não
// deduplicaria as linhas agregadas da loja.
// ─────────────────────────────────────────────────────────────
model AdSpend {
  id      String @id @default(uuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  platform           AdPlatform @default(TIKTOK)
  date               DateTime   @db.Date
  externalCampaignId String     @default("")

  spendCents  Int @default(0)
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([storeId, platform, date, externalCampaignId])
  @@index([storeId, date])
}

// ─────────────────────────────────────────────────────────────
// Coleção: agrupa produtos de uma loja.
//
// Serve pra dois lugares ao mesmo tempo — a vitrine em seções e o
// feed de catálogo filtrado por tema (/catalog/{loja}/feed.csv?colecao=slug),
// que é o que permite rodar campanha só de uma linha de produto em
// vez do catálogo inteiro.
//
// A relação com Product é N:N: o mesmo produto pode aparecer em mais
// de uma coleção, e tirar da coleção não apaga o produto.
// ─────────────────────────────────────────────────────────────
model Collection {
  id      String @id @default(uuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  title       String
  slug        String // usado na URL do feed filtrado
  description String?
  active      Boolean @default(true)
  ordem       Int     @default(0) // posição da seção na vitrine

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, slug]) // slug só precisa ser único dentro da loja
  @@index([storeId])
}

// ─────────────────────────────────────────────────────────────
// Criação de contas de anúncio em lote, um alvo por Business
// Center. O lote roda em segundo plano (pode levar horas com as
// esperas entre tentativas), então o progresso vive no banco: a
// tela consulta daqui, não segura a requisição aberta.
// ─────────────────────────────────────────────────────────────
model AdAccountBatch {
  id      String @id @default(uuid())
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  bcIds         String[] // um alvo por BC
  alvoPorBc     Int      @default(28)
  maxTentativas Int      @default(20) // teto por conta, pra erro que não é transitório

  // Molde da conta: o payload de /bc/advertiser/create/ é igual pra
  // todas as contas do lote, só o nome muda. Fica no lote (e não em
  // Store) porque o lote seguinte pode usar outra empresa ou outro BC.
  nomePrefixo    String
  currency       String   @default("BRL")
  timezone       String   @default("America/Sao_Paulo")
  company        String
  industry       Int
  registeredArea String   @default("BR")

  // Exigidos no Brasil pela API — sem eles a criação é negada, e
  // negação por campo faltando não passa por insistência.
  contactEmail          String?
  contactName           String?
  contactNumber         String?
  licenseNo             String? // CNPJ
  qualificationImageIds String[] // via /bc/image/upload/
  promotionLink         String?
  taxId                 String?
  billingAddress        String?

  status     String  @default("RODANDO") // RODANDO | CONCLUIDO | PARADO
  observacao String? @db.Text

  contas    AdAccount[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([storeId])
}

// Uma linha por conta que o lote tentou criar. Guarda a contagem de
// tentativas e o último erro pra que insistência não vire caixa preta:
// dá pra ver quantas passaram, quantas travaram e por quê.
model AdAccount {
  id      String         @id @default(uuid())
  batch   AdAccountBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String

  bcId                 String
  nome                 String
  externalAdvertiserId String? // id devolvido pelo TikTok

  status       String  @default("PENDENTE") // PENDENTE | CRIADA | ERRO
  tentativas   Int     @default(0)
  ultimaClasse String? // REDE | LIMITE | SERVIDOR | NEGOCIO | COTA
  ultimoErro   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([bcId])
}
